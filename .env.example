# Copy to .env and edit as needed. `.env` itself is gitignored - never commit real
# production KECO credentials (see kvas/config.py, D2 of
# .vscode/plans/2026-08-12-kvas-relay-to-keco.md).
#
# All values below are the public KECO TEST-server defaults
# (KVAS_Docs/downloadJfile3.pdf) - relay mode works out of the box against the test
# server with none of these set.

# "local_ministry" (default, unchanged Stage 0 behaviour) or "relay" (forward
# GetEncKey/Battery Info to KECO's real REST API - see kvas/relay.py).
KVAS_MODE=local_ministry

# KECO REST endpoint. Production is 10.101.160.34, behind a VPN - see
# kvas-explained.md §9 in the SmartyPluggerIotBoard repo.
KVAS_KECO_HOST=121.141.6.27
KVAS_KECO_PORT=35083

# Institution credentials. JA/JA_TEST are KECO's published test values - real
# production bid/bkey are not held anywhere in this repo.
KVAS_KECO_BID=JA
KVAS_KECO_BKEY=JA_TEST
